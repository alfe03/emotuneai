# MoodTune Backend – Environment Variables
# Bu dosyayı .env olarak kopyala: cp .env.example .env

APP_NAME=MoodTune
DEBUG=True
SECRET_KEY=super-secret-key-change-this

# PostgreSQL (docker-compose ile aynı)
DATABASE_URL=postgresql://postgres:password@db:5432/moodtune

# Spotify API
# → https://developer.spotify.com/dashboard adresine gidip app oluştur
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
