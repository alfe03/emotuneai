# MoodTune Backend – Environment Variables
# Bu dosyayı .env olarak kopyala: cp .env.example .env

APP_NAME=EmotuneAI
DEBUG=True
SECRET_KEY=super-secret-key-change-this

# PostgreSQL (docker-compose ile aynı)
DATABASE_URL=postgresql://postgres:password@db:5432/moodtune

# Spotify API
# → https://developer.spotify.com/dashboard adresine gidip app oluştur
SPOTIFY_CLIENT_ID=d377116dd94b4125abb564bdcd0f2a28
SPOTIFY_CLIENT_SECRET=2a732ff6fd954125a265896d5429f633

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini AI (Metin Analizi için)
# → https://aistudio.google.com/ adresinden API key al
GEMINI_API_KEY=your_gemini_api_key_here
