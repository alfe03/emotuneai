# EmoTuneAI Backend – Environment Variables
# Bu dosyayı .env olarak kopyala: cp .env.example .env

APP_NAME=EmotuneAI
DEBUG=True
SECRET_KEY=super-secret-key-change-this

# PostgreSQL (docker-compose ile aynı)
DATABASE_URL=postgresql://postgres:password@db:5432/emotune

# Spotify API
# → https://developer.spotify.com/dashboard adresine gidip app oluştur
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini AI (Metin Analizi için)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL (Spotify redirect için)
FRONTEND_URL=http://127.0.0.1:8080/index.html

# Spotify Redirect URI (production'da değiştir)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/spotify/callback

# CORS Origins (comma-separated, production'da localhost'u kaldır)
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,https://emotuneai.com
